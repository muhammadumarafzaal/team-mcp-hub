# ==============================================================================
# Remote MCP Server Configuration (.env)
# ==============================================================================

# Server Metadata
SERVER_NAME="Team Remote MCP Server"
SERVER_VERSION="0.1.0"
SERVER_INSTRUCTIONS="Shared remote MCP server providing team notes, diagnostics, calculations, and web utilities."

# Network Configuration
HOST=0.0.0.0
PORT=8000

# MCP Protocol Transport ('sse' or 'http')
# Recommended: 'sse' for broadest client compatibility (Cursor, Claude Desktop, Cline, etc.)
TRANSPORT=sse

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Primary authentication token. If non-empty, all MCP calls require this Bearer token.
# If left empty, server runs in open mode (unauthenticated).
AUTH_TOKEN=your-secure-random-token-here

# Optional: Comma-separated list of additional valid member tokens
# Example: AUTH_TOKENS=alice-token-9812,bob-token-7341,charlie-token-5519
AUTH_TOKENS=

# ------------------------------------------------------------------------------
# Storage & CORS
# ------------------------------------------------------------------------------
# Path where persistent data (team notes) is saved
DATA_DIR=./data

# Allowed CORS origins (comma-separated or '*' for all)
CORS_ORIGINS=*

# Logging level: debug, info, warning, error
LOG_LEVEL=info
